---
import Layout from "../layouts/Layout.astro";

const links = [
    { name: "Strona główna", href: "/" },
    { name: "Nasze usługi", href: "/uslugi" },
    { name: "Baza wiedzy", href: "/baza-wiedzy" },
    { name: "Aktualności", href: "/wpisy" },
    { name: "O nas", href: "/o-nas" },
];
---

<Layout title="Strona nie została znaleziona — Michalak24"
         description="Strona, której szukasz, nie istnieje lub została przeniesiona. Skorzystaj z menu lub zadzwoń do nas — pomoć drogowa Kalisz działa 24/7.">

    <main class="bg-black min-h-screen flex items-center">
        <section class="relative w-full overflow-hidden">
            <div class="absolute inset-0 bg-gradient-to-b from-black via-black to-zinc-900"></div>

            <div class="relative z-10 max-w-7xl mx-auto px-6 md:px-12 lg:px-20 py-24 md:py-32 flex flex-col items-center text-center">

                <span class="text-yellow-400 text-xs font-bold uppercase tracking-[0.25em]">Błąd 404</span>

                <p class="mt-4 text-7xl md:text-9xl font-black text-white leading-none tracking-tight">
                    4<span class="text-yellow-400">0</span>4
                </p>

                <h1 class="mt-6 text-3xl md:text-5xl font-black text-white uppercase leading-tight">
                    Ta strona <span class="text-yellow-400">zniknęła z drogi</span>
                </h1>

                <p class="mt-5 max-w-xl text-zinc-400 text-base md:text-lg leading-relaxed">
                    Adres, który otworzyłeś, nie istnieje albo został przeniesiony. Nic się nie stało —
                    wybierz jedną z poniższych sekcji albo po prostu wróć na stronę główną.
                </p>

                <div class="mt-10 flex flex-col sm:flex-row items-center gap-4">
                    <a href="/"
                       class="inline-flex items-center gap-3 bg-yellow-400 hover:bg-yellow-300 text-black font-black px-8 py-4 rounded-xl transition-all duration-200 uppercase tracking-wide text-sm">
                        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M19 12H5M12 19l-7-7 7-7"/>
                        </svg>
                        Wróć na stronę główną
                    </a>

                    <a href="tel:+48571531112"
                       class="inline-flex items-center gap-3 border border-yellow-400 hover:bg-yellow-400 text-yellow-400 hover:text-black font-black px-8 py-4 rounded-xl transition-all duration-200 uppercase tracking-wide text-sm">
                        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor">
                            <path d="M6.62 10.79a15.05 15.05 0 006.59 6.59l2.2-2.2a1 1 0 011.01-.24c1.12.37 2.33.57 3.58.57a1 1 0 011 1V20a1 1 0 01-1 1C10.61 21 3 13.39 3 4a1 1 0 011-1h3.5a1 1 0 011 1c0 1.25.2 2.46.57 3.58a1 1 0 01-.25 1.01l-2.2 2.2z"/>
                        </svg>
                        Zadzwoń 571 531 112
                    </a>
                </div>

                <nav aria-label="Sekcje serwisu" class="mt-16 w-full max-w-4xl">
                    <p class="text-zinc-400 text-xs font-bold uppercase tracking-[0.25em] mb-6">
                        Gdzie chcesz trafić?
                    </p>

                    <ul class="flex flex-wrap justify-center gap-3">
                        {links.map((link) => (
                            <li>
                                <a href={link.href}
                                   class="inline-flex items-center justify-center min-h-[48px] px-6 py-3 bg-zinc-900 border border-zinc-800 hover:border-yellow-400 hover:text-yellow-400 text-white font-bold uppercase tracking-wide text-sm rounded-xl transition-all duration-200">
                                    {link.name}
                                </a>
                            </li>
                        ))}
                    </ul>
                </nav>

                <div class="mt-16 w-full max-w-2xl rounded-[2rem] bg-zinc-900 border border-zinc-800 px-8 py-8">
                    <div class="flex items-center justify-center gap-2 mb-3">
                        <span class="w-2 h-2 rounded-full bg-yellow-400 animate-pulse"></span>
                        <h2 class="text-yellow-400 text-xs font-bold uppercase tracking-[0.25em]">
                            Pomoc drogowa 24/7
                        </h2>
                    </div>
                    <p class="text-zinc-300 text-base md:text-lg leading-relaxed">
                        Potrzebujesz holowania, lawety albo pomocy na drodze? Jesteśmy w Kaliszu
                        i okolicach — zadzwoń, a przyjedziemy.
                    </p>
                    <p class="mt-4 text-white font-black text-lg md:text-xl">
                        +48 571 531 112
                    </p>
                </div>

            </div>
        </section>
    </main>
</Layout>