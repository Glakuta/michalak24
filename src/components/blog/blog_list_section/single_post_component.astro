---
import {getSinglePostQuery} from "../../../data/getSinglePost.ts";
import Layout from "../../../layouts/Layout.astro";

const { slug } = Astro.params;
if (!slug) {
    return Astro.redirect('/404');
}

// 1. Pobieramy surowe dane z WordPressa (zawsze przyjdzie tablica)
const postsRaw = await getSinglePostQuery(slug);

// 2. Wyciągamy pierwszy post z tablicy. Jeśli tablica jest pusta, ustawiamy null
const post = postsRaw && postsRaw.length > 0 ? postsRaw[0] : null;

// 3. Jeśli post nie istnieje w bazie WP, elegancko przekierowujemy użytkownika na 404
if (!post) {
    return Astro.redirect('/404');
}

// Formatowanie daty (bezpieczne, bo wiemy już, że post istnieje)
const formattedDate = new Date(post.date).toLocaleDateString('pl-PL', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
});

// Pobieranie zdjęcia wyróżniającego z fallbackiem
const featuredImage = post._embedded?.['wp:featuredmedia']?.[0]?.source_url
    || '/images/default-blog-hero.jpg';
---

<Layout title={`${post.title?.rendered || 'Wpis'} - Blog Michalak-24`}>
    <article class="bg-zinc-950 text-white min-h-screen pt-28 pb-20 px-4">
        <div class="max-w-7xl mx-auto">

            <nav class="mb-6 flex items-center gap-2 text-sm text-zinc-500">
                <a href="/" class="hover:text-[#FF7A00] transition-colors">Główna</a>
                <span>/</span>
                <a href="/blog" class="hover:text-[#FF7A00] transition-colors">Blog</a>
                <span>/</span>
                <span class="text-zinc-400 truncate max-w-[200px] md:max-w-none" set:html={post.title?.rendered} />
            </nav>

            <header class="max-w-4xl mb-12">
                <div class="flex items-center gap-4 text-xs md:text-sm font-semibold uppercase tracking-wider text-[#FF7A00] mb-4">
                    <time datetime={post.date}>{formattedDate}</time>
                    <span class="w-1.5 h-1.5 rounded-full bg-zinc-700"></span>
                    <span>Autor: Michalak-24</span>
                </div>
                <h1
                        class="text-3xl md:text-5xl lg:text-6xl font-black uppercase tracking-tight leading-tight text-white mb-6"
                        set:html={post.title?.rendered}
                />
            </header>

            <div class="w-full h-[250px] sm:h-[400px] lg:h-[550px] rounded-3xl overflow-hidden shadow-2xl mb-12 border border-zinc-900">
                <img
                        src={featuredImage}
                        alt={post.title?.rendered || "Zdjęcie wpisu"}
                        class="w-full h-full object-cover"
                        loading="eager"
                />
            </div>

            <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">

                <main class="lg:col-span-8 bg-zinc-900/30 border border-zinc-900 rounded-3xl p-6 md:p-10 shadow-xl">
                    <div class="
                        [&_p]:text-zinc-300 [&_p]:text-base [&_p]:leading-relaxed [&_p]:mb-6
                        [&_h2]:text-white [&_h2]:text-2xl [&_h2]:font-black [&_h2]:uppercase [&_h2]:mt-10 [&_h2]:mb-4
                        [&_h3]:text-[#FF7A00] [&_h3]:text-xl [&_h3]:font-bold [&_h3]:mt-8 [&_h3]:mb-3
                        [&_strong]:text-white [&_strong]:font-bold
                        [&_a]:text-[#FF7A00] [&_a]:underline hover:[&_a]:text-white
                        [&_blockquote]:border-l-4 [&_blockquote]:border-[#FF7A00] [&_blockquote]:pl-6 [&_blockquote]:italic [&_blockquote]:text-zinc-400 [&_blockquote]:my-8
                    " set:html={post.content?.rendered} />
                </main>

                <aside class="lg:col-span-4 sticky top-28 flex flex-col gap-6">

                    <div class="bg-gradient-to-br from-zinc-900 to-zinc-950 border-2 border-[#FF7A00] rounded-3xl p-6 shadow-xl text-center">
                        <div class="w-12 h-12 bg-[#FF7A00]/10 text-[#FF7A00] rounded-full flex items-center justify-center mx-auto mb-4">
                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-6 h-6 animate-pulse">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 0 0 2.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.387a12.017 12.017 0 0 1-4.525-4.525c-.156-.44.01-.928.387-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 0 0-1.091-.852H4.5A2.25 2.25 0 0 0 2.25 4.5v2.25Z" />
                            </svg>
                        </div>
                        <h3 class="text-xl font-black uppercase tracking-tight text-white mb-2">Utknąłeś na drodze?</h3>
                        <p class="text-zinc-400 text-sm mb-6">
                            Czytasz ten artykuł, bo masz problem z autem? Nie ryzykuj – nasi kierowcy w Kaliszu są gotowi do akcji.
                        </p>
                        <a href="tel:+483462346973" class="block w-full bg-[#FF7A00] hover:bg-white text-zinc-950 font-black text-center py-4 rounded-xl transition-all duration-300 uppercase tracking-wide text-sm shadow-lg shadow-[#FF7A00]/20">
                            Zadzwoń teraz: 24H
                        </a>
                    </div>

                    <div class="bg-zinc-900/50 border border-zinc-900 rounded-3xl p-6 text-sm text-zinc-400">
                        <h4 class="font-bold text-white uppercase text-xs tracking-wider mb-2 text-[#FF7A00]">Obsługiwany rejon</h4>
                        <p>Dojedziemy do Ciebie w miastach: Kalisz, Ostrów Wielkopolski, Pleszew, Nowe Skalmierzyce, Opatówek oraz na trasach krajowych regionu.</p>
                    </div>

                </aside>

            </div>
        </div>
    </article>
</Layout>