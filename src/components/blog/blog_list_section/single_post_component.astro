---
import { getSinglePostQuery } from "../../../data/getSinglePost.ts";
import Layout from "../../../layouts/Layout.astro";
import Image from "astro/components/Image.astro";
import hero from "../../../assets/DAF_hero.jpg";

const { slug } = Astro.params;
if (!slug) {
    return Astro.redirect('/404');
}

const postsRaw = await getSinglePostQuery(slug);
const post = postsRaw && postsRaw.length > 0 ? postsRaw[0] : null;

if (!post) {
    return Astro.redirect('/404');
}

const formattedDate = new Date(post.date).toLocaleDateString('pl-PL', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
});

const media = post._embedded?.['wp:featuredmedia']?.[0];
const featuredSize = media?.media_details?.sizes?.large
    || media?.media_details?.sizes?.medium_large;
const featuredImage =
    featuredSize?.source_url
    || media?.source_url
    || hero.src;
const featuredWidth = featuredSize?.width || media?.media_details?.width || 1920;
const featuredHeight = featuredSize?.height || media?.media_details?.height || 887;

const rawTitle = post.title?.rendered || 'Wpis';
const plainTitle = rawTitle.replace(/&#(\d+);/g, (_, code) => String.fromCharCode(code));

const getCategoryName = (post: any) => {
    const terms = post._embedded?.['wp:term']?.[0];
    return terms?.[0]?.name || 'Artykuł';
};

const cleanText = (html: string) =>
    html?.replace(/<[^>]*>/g, '').replace(/&#(\d+);/g, (_, c) => String.fromCharCode(c)) || '';
---

<Layout title={`${plainTitle} - Blog Michalak24`}>
    <main class="bg-black min-h-screen">
        <div class="relative h-[60vh] lg:h-[50vh] overflow-hidden flex items-end bg-zinc-900">
            <div class="absolute inset-0">
                {media?.source_url ? (
                    <img
                        src={featuredImage}
                        alt={plainTitle}
                        class="w-full object-cover object-center h-full"
                        width={featuredWidth}
                        height={featuredHeight}
                        loading="lazy"
                    />
                ) : (
                    <Image src={hero} alt="Michalak 24" class="w-full object-cover object-center h-full" width={1920} height={887} loading="lazy" />
                )}
                <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-black/40 to-white/40"></div>
            </div>
            <div class="relative z-10 max-w-7xl mx-auto px-6 md:px-12 lg:px-20 pb-12 w-full">
                <nav aria-label="Okruszki nawigacyjne" class="mb-4 flex items-center gap-2 text-xs text-zinc-400">
                    <a href="/" class="hover:text-yellow-400 transition-colors uppercase tracking-wider">Główna</a>
                    <span class="text-zinc-600">/</span>
                    <a href="/wpisy" class="hover:text-yellow-400 transition-colors uppercase tracking-wider">Aktualności</a>
                    <span class="text-zinc-600">/</span>
                    <span class="text-zinc-400 truncate max-w-[200px] md:max-w-none" set:html={post.title?.rendered} />
                </nav>
                <div class="flex items-center gap-4 text-xs md:text-sm font-semibold uppercase tracking-wider text-yellow-400 mb-4">
                    <time datetime={post.date}>{formattedDate}</time>
                    <span class="w-1.5 h-1.5 rounded-full bg-zinc-700"></span>
                    <span>Autor: Michalak24</span>
                </div>
                <h1 class="text-3xl md:text-5xl lg:text-6xl font-black uppercase tracking-tight leading-tight text-white mb-6" set:html={post.title?.rendered} />
                <div class="flex items-center gap-6 text-zinc-300 text-sm">
                    <div class="flex items-center gap-2">
                        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/>
                        </svg>
                        <span class="font-bold uppercase tracking-widest bg-yellow-400 text-black px-3 py-1 rounded-full text-xs">{getCategoryName(post)}</span>
                    </div>
                    <div class="flex items-center gap-2">
                        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/>
                        </svg>
                        {formattedDate}
                    </div>
                </div>
            </div>
        </div>

        <div class="max-w-7xl mx-auto px-6 md:px-12 lg:px-20 py-16 flex flex-col gap-12">
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
                <div class="lg:col-span-8">
                    <article class="bg-zinc-900/30 border border-zinc-800 rounded-2xl p-6 md:p-10 shadow-xl">
                        <div class="
                            [&_p]:text-zinc-300 [&_p]:text-base [&_p]:leading-relaxed [&_p]:mb-6
                            [&_h1]:text-white [&_h1]:text-3xl [&_h1]:font-black [&_h1]:uppercase [&_h1]:mt-12 [&_h1]:mb-5
                            [&_h2]:text-white [&_h2]:text-2xl [&_h2]:font-black [&_h2]:uppercase [&_h2]:mt-10 [&_h2]:mb-4
                            [&_h3]:text-yellow-400 [&_h3]:text-xl [&_h3]:font-bold [&_h3]:mt-8 [&_h3]:mb-3
                            [&_strong]:text-white [&_strong]:font-bold
                            [&_a]:text-yellow-400 [&_a]:underline hover:[&_a]:text-white
                            [&_blockquote]:border-l-4 [&_blockquote]:border-yellow-400 [&_blockquote]:pl-6 [&_blockquote]:italic [&_blockquote]:text-zinc-400 [&_blockquote]:my-8
                            [&_ul]:list-disc [&_ul]:pl-6 [&_ul]:mb-6 [&_ul]:text-zinc-300
                            [&_ol]:list-decimal [&_ol]:pl-6 [&_ol]:mb-6 [&_ol]:text-zinc-300
                            [&_li]:mb-2
                            [&_img]:rounded-xl [&_img]:w-full [&_img]:h-auto [&_img]:my-6 [&_img]:shadow-lg
                            [&_figure]:my-6 [&_figure]:mx-auto [&_figure]:max-w-full
                            [&_figcaption]:text-xs [&_figcaption]:text-zinc-400 [&_figcaption]:text-center [&_figcaption]:mt-2
                        " set:html={post.content?.rendered} />
                    </article>
                </div>

                <aside class="lg:col-span-4 sticky top-28 flex flex-col gap-6">
                    <div class="bg-zinc-900 border-2 border-yellow-400 rounded-2xl p-6 shadow-xl text-center">
                        <div class="w-12 h-12 bg-yellow-400/10 text-yellow-400 rounded-full flex items-center justify-center mx-auto mb-4">
                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-6 h-6 animate-pulse">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 0 0 2.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.387a12.017 12.017 0 0 1-4.525-4.525c-.156-.44.01-.928.387-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 0 0-1.091-.852H4.5A2.25 2.25 0 0 0 2.25 4.5v2.25Z" />
                            </svg>
                        </div>
                        <h3 class="text-xl font-black uppercase tracking-tight text-white mb-2">Potrzebujesz pomocy na drodze?</h3>
                        <p class="text-zinc-400 text-sm mb-6">
                            Czytasz ten artykuł, bo masz problem z autem? Nie ryzykuj – nasi kierowcy w Kaliszu są gotowi do akcji.
                        </p>
                        <a href="tel:571531112" class="block w-full bg-yellow-400 hover:bg-white text-black font-black text-center py-4 rounded-xl transition-all duration-300 uppercase tracking-wide text-sm shadow-lg shadow-yellow-400/20">
                            Zadzwoń teraz: 24H
                        </a>
                    </div>

                    <div class="bg-zinc-900/50 border border-zinc-800 rounded-2xl p-6 text-sm text-zinc-400">
                        <h4 class="font-bold text-white uppercase text-xs tracking-wider mb-2 text-yellow-400">Obsługiwany rejon</h4>
                        <p>Dojedziemy do Ciebie w miastach: Kalisz, Ostrów Wielkopolski, Pleszew, Nowe Skalmierzyce, Opatówek oraz na trasach krajowych regionu.</p>
                    </div>
                </aside>
            </div>
        </div>
    </main>
</Layout>