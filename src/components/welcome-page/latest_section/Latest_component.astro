---
export const prerender = false;
import Image from "astro/components/Image.astro";
import photo from "../../../assets/20211124_220606-scaled.jpg";
import { getPostsQuery } from "../../../data/getPostsQuery.ts";
import {
    cleanText,
    formatPostDate,
    getCategoryName,
    getFeaturedImage,
    getFeaturedImageSize,
    getPostSummary,
    getReadTime,
} from "../../../data/postHelpers.ts";

const LIMIT = 3;

const allPosts = await getPostsQuery();
const posts = (allPosts ?? []).slice(0, LIMIT);
---

<section class="bg-black py-20 px-6 md:px-12 lg:px-20">
    <div class="max-w-7xl mx-auto flex flex-col gap-12">

        <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4">
            <div>
                <span class="text-yellow-400 text-xs font-bold uppercase tracking-[0.25em]">Wiedza i porady</span>
                <h2 class="mt-2 text-4xl md:text-5xl font-black text-white leading-tight">
                    Ostatnie <span class="text-yellow-400">wpisy</span>
                </h2>
            </div>

            <a href="/wpisy"
            class="inline-flex items-center gap-2 border border-yellow-400 text-yellow-400 hover:bg-yellow-400 hover:text-black font-bold px-6 py-3 rounded-xl transition-all duration-200 w-fit"
            >
            Zobacz wszystkie wpisy
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M7 17L17 7M17 7H7M17 7v10"/>
            </svg>
            </a>
        </div>


        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            {posts.length === 0 ? (
                    <p class="md:col-span-2 lg:col-span-3 text-zinc-400 text-center py-12">
                        Brak wpis\u00f3w do wy\u015bietlenia.
                    </p>
            ) : posts.map((post) => (
                    <a href={`/wpisy/${post.slug}`}
                class="group flex flex-col bg-zinc-900 border border-zinc-800 hover:border-yellow-500/50 rounded-2xl overflow-hidden transition-all duration-300 hover:-translate-y-1 hover:shadow-xl hover:shadow-yellow-400/5"
                    >
                        <div class="px-6 pt-6 flex items-center justify-between">
                         <span class="text-yellow-400 text-xs font-bold uppercase tracking-[0.25em]">
                            {getCategoryName(post)}
                         </span>
                            <span class="text-xs text-zinc-400">{formatPostDate(post.date)}</span>
                        </div>
                    <div class="overflow-hidden rounded-2xl mb-8">
                        {getFeaturedImage(post) ? (
                                <img
                                        src={getFeaturedImage(post)!}
                                        alt={cleanText(post.title.rendered)}
                                        class="w-full h-64 object-cover p-6"
                                        width={getFeaturedImageSize(post).width}
                                        height={getFeaturedImageSize(post).height}
                                        loading="lazy"
                                />
                        ) : (
                                <Image
                                        src={photo}
                                        alt="Wn\u0119trze samochodu"
                                        class="w-full h-64 object-cover p-6 "
                                        width={2560}
                                        height={1105}
                                        loading="lazy"
                                />
                        )}
                    </div>


                        <div class="flex flex-col gap-3 px-6 py-5 flex-1">
                            <h3 class="text-white font-bold text-lg leading-snug group-hover:text-yellow-400 transition-colors duration-200">
                                {cleanText(post.title.rendered)}
                            </h3>
                            <p class="text-zinc-400 text-sm leading-relaxed line-clamp-3">
                                {getPostSummary(post)}
                            </p>
                        </div>



                        <div class="px-6 pb-6 flex items-center justify-between border-t border-zinc-800 pt-4 mt-auto">
            <span class="text-xs text-zinc-400 flex items-center gap-1.5">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>
              </svg>
                {getReadTime(post)} min czytania
            </span>
                            <span class="text-yellow-400 text-sm font-semibold flex items-center gap-1 group-hover:gap-2 transition-all duration-200">
              Czytaj
              <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M5 12h14M12 5l7 7-7 7"/>
              </svg>
            </span>
                        </div>
                </a>
                ))}
        </div>
    </div>
</section>