---
import "../../../assets/styles/global.css"
import Image from 'astro/components/Image.astro';
import pomocDrogowa from '../../../assets/pomoc drogowa - michalak24.png'
import transport from '../../../assets/transport auta - michalak 24.png'
import tyre from "../../../assets/przebita opona.png"
import battery from "../../../assets/akumulator-michalak24.png"
import fuel from "../../../assets/car.png"

const data = [
    {
        title: "Pomoc drogowa",
        points: ["Awarie", "Kolizje", "Wypadkie"],
        description:"Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua",
        icon: pomocDrogowa,
    },
    {
        title: "Transport pojazdu",
        points: ["Osobowe", "Dostawcze", "Ciężarowe"],
        description:"Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua",
        icon: transport
    },
    {
        title: "Wymiana koła",
        points: ["Osobowe", "Dostawcze", "Ciężarowe"],
        description:"Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua",
        icon: tyre
    },
    {
        title: "Odpalanie z kabli",
        points: ["Awarie", "Kolizje", "Wypadkie"],
        description:"Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua",
        icon: battery
    },
    {
        title: "Dowóz paliwa",
        points: ["Benzyna", "Olej napędowy"],
        description:"Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua",
        icon: fuel
    },
    {
        title: "Wyciąganie z trudnych miejsc",
        points: ["Rowy", "Błota", "Zaspy"],
        description:"Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua",
        icon: fuel
    },
]

---

<section class="py-20 px-6 md:px-12 lg:px-20 my-[11vh]">
    <ul class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8 max-w-6xl mx-auto">
        {data.map((item, index) => (
                <li class="bg-yellow-400 backdrop-blur-sm rounded-2xl p-8 flex flex-col gap-4 hover:bg-white/30 hover:-translate-y-1 transition-all duration-300">
                    <div class="w-20 h-20 m-auto  rounded-xl flex items-center justify-center">
                        <Image src={item.icon} alt="Transport auta - Michalak24" class="w-16 h-16 object-contain"/>
                    </div>
                    <div class="flex flex-col gap-1">
                        <h3 class="font-extrabold text-xl text-black tracking-tight mx-auto">{item.title}</h3>
                        <div class="flex items-center justify-center gap-2 font-semibold text-sm text-black/70 uppercase tracking-wide mx-auto">
                            {[item.points].map((item, index) => (
                                    <>
                                        <span>{item}</span>
                                        {index < 1 && <span class="text-black-500 font-bold">·</span>}
                                    </>
                            ))}
                        </div>
                    </div>
                    <p class="text-black/80 text-sm leading-relaxed">{item.description}</p>
                </li>
        ))}
    </ul>
</section>
