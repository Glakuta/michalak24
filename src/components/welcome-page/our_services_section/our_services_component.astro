---
import "../../../assets/styles/global.css"
import Image from 'astro/components/Image.astro';
import pomocDrogowa from '../../../assets/pomoc drogowa - michalak24.png'
import transport from '../../../assets/transport auta - michalak 24.png'
import tyre from "../../../assets/przebita opona.png"
import battery from "../../../assets/akumulator-michalak24.png"
import car from "../../../assets/car.png"
import tir from "../../../assets/icons8-car-64.png"
import tirTyre from "../../../assets/icons8-motor-vehicle-64.png"

const data = [
    {
        title: "Pomoc Drogowa",
        points: ["Awarie", "Kolizje", "Wypadki"],
        description: "Całodobowa pomoc drogowa dla samochodów osobowych, dostawczych i ciężarowych na terenie Kalisza i okolic.",
        icon: pomocDrogowa,
        width: 512,
        height: 512,
    },
    {
        title: "Usługi transportowe",
        points: ["Osobowe", "Dostawcze", "Ciężarowe"],
        description: "Świadczyny  usługi transportowe na terenie całego kraju. Posiadamy niezbędne pozwolenia i ubezpieczenia do realizacji tych  usług na najwyższym poziomie.",
        icon: transport,
        width: 512,
        height: 512,
    },
    {
        title: "Wymiana koła",
        points: ["Osobowe", "Dostawcze", "Ciężarowe"],
        description: "Problem z odkręceniem śruby od koła?  Śruby sa za mocno dokręcone? Zadzwoń do Nas. Przyjedziemy pomożemy",
        icon: tyre,
        width: 512,
        height: 512,
    },
    {
        title: "Odpalanie samochodów",
        points: ["Osobowe", "Dostawcze", "Ciężarowe"],
        description: "Słaby lub rozładowany akumulator? Odpalimy Twój samochód przy pomocy profesjonalnych urządzeń rozruchowych.",
        icon: battery,
        width: 512,
        height: 512,
    },
    {
        title: "Wyciąganie z trudnych miejsc",
        points: ["Rowy", "Błota", "Zaspy"],
        description: "Wpadłeś do rowu swoim samochodem, a może zakopałeś się w błocie lub śniegu Jesteśmy do Twojej dyspozycji 24h/7. Zadzwoń po nas a przyjedziemy i pomożemy w trudnej sytuacji z Twoim samochodem.",
        icon: car,
        width: 512,
        height: 512,
    },
    {
        title: "Mobilny mechanik TIR",
        points: ["Naprawy", "Diagnostyka", "Serwis", "Holowanie"],
        description: "Twoja Ciężarówka uległa awarii podczas drogi ? Spokojnie, nasz mobilny mechanik przyjedzie i zdiagnozuje usterkę a w razie konieczności zorganizujemy holowanie Twojego samochodu do  sprawdzonego Warsztatu dla samochodów ciężarowych.",
        icon: tir,
        width: 64,
        height: 64,
    },
    {
        title: "Mobilna wulkanizacja TIR",
        points: ["Opony", "Koła", "Serwis"],
        description: "Awaria ogumienia w Twoim samochodzie dostaeczym.ciężarowym lub naczepie ? Problem z odkręceniem śrub? Wymiana koła lub opony ? Dla nas to Żaden problem. Zadzwoń do nas a wyślemy do Ciebie mobilny serwis ogumienia by przywrócił Twój pojazd do dalszej drogi.",
        icon: tirTyre,
        width: 64,
        height: 64,
    },
    {
        title: "Parking strzeżony 24/7",
        points: ["Osobowe", "Dostawcze", "Ciężarowe"],
        description: "Bezpieczny parking strzeżony całodobowo dla samochodów osobowych, dostawczych i ciężarowych.",
        icon: car,
        width: 512,
        height: 512,
    },
]
---

<section class="py-16 sm:py-20 px-4 sm:px-6 md:px-12 lg:px-20 my-[11vh]">
    <ul class="services-grid max-w-6xl mx-auto">
        {data.map((item) => (
                <li class="service-card bg-yellow-400 backdrop-blur-sm rounded-2xl p-6 sm:p-8 hover:bg-white/30 hover:-translate-y-1 transition-all duration-300">
                    <div class="service-icon w-20 h-20 rounded-xl flex items-center justify-center">
                        {item.icon ? (
                                <Image src={item.icon} alt={item.title} class="w-16 h-16 object-contain" width={item.width} height={item.height} loading="lazy"/>
                        ) : (
                                <div class="w-16 h-16 bg-gray-300/60 rounded-lg flex items-center justify-center text-gray-500 text-xs font-semibold">
                                    Ikona
                                </div>
                        )}
                    </div>
                    <h3 class="service-title font-extrabold text-lg sm:text-xl text-black tracking-tight text-center">{item.title}</h3>
                    <div class="service-points flex flex-wrap items-center justify-center gap-x-3 gap-y-1 font-semibold text-xs sm:text-sm text-black/70 uppercase tracking-wide text-center">
                        {item.points.map((point, index) => (
                                <span class="inline-flex items-center whitespace-nowrap">
                            {index > 0 && (
                                    <span class="text-black/50 font-bold mr-1.5" aria-hidden="true">·</span>
                            )}
                                    <span>{point}</span>
                        </span>
                        ))}
                    </div>
                    <p class="service-description text-black/80 text-sm leading-relaxed text-center">{item.description}</p>
                </li>
        ))}
    </ul>
</section>

<style>
    .services-grid {
        display: flex;
        flex-wrap: wrap;
        align-items: stretch;
        justify-content: center;
        gap: 1rem;
    }

    .service-card {
        display: flex;
        flex-direction: column;
        align-items: stretch;
        gap: 1rem;
        width: 100%;
    }

    .service-icon {
        margin-inline: auto;
    }

    .service-title {
        display: block;
        text-align: center;
    }

    .service-points {
        align-content: flex-start;
    }

    .service-description {
        text-align: center;
    }

    @media (min-width: 640px) {
        .services-grid {
            gap: 1.5rem;
        }

        .service-card {
            width: calc(50% - 0.75rem);
        }

        .service-title {
            min-height: 3.5rem;
        }

        .service-points {
            min-height: 2.75rem;
        }
    }

    @media (min-width: 1024px) {
        .services-grid {
            gap: 2rem;
        }

        .service-card {
            width: calc(33.333% - 1.334rem);
        }
    }
</style>