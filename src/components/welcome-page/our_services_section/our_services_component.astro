---
import "../../../assets/styles/global.css"
import Image from 'astro/components/Image.astro';
import pomocDrogowa from '../../../assets/pomoc drogowa - michalak24.png'
import transport from '../../../assets/transport auta - michalak 24.png'
import tyre from "../../../assets/przebita opona.png"
import battery from "../../../assets/akumulator-michalak24.png"
import fuel from "../../../assets/icons8-petrol-64.png"
import car from "../../../assets/car.png"
import tir from "../../../assets/icons8-car-64.png"
import tirTyre from "../../../assets/icons8-motor-vehicle-64.png"

const data = [
    {
        title: "Pomoc Drogowa",
        points: ["Awarie", "Kolizje", "Wypadki"],
        description: "Całodobowa pomoc drogowa dla samochodów osobowych, dostawczych i ciężarowych na terenie Kalisza i okolic.",
        icon: pomocDrogowa,
    },
    {
        title: "Usługi transportowe",
        points: ["Osobowe", "Dostawcze", "Ciężarowe"],
        description: "Świadczyny  usługi transportowe na terenie całego kraju. Posiadamy niezbędne pozwolenia i ubezpieczenia do realizacji tych  usług na najwyższym poziomie.",
        icon: transport
    },
    {
        title: "Wymiana koła",
        points: ["Osobowe", "Dostawcze", "Ciężarowe"],
        description: "Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua",
        icon: tyre
    },
    {
        title: "Odpalanie z kabli",
        points: ["Awarie", "Kolizje", "Wypadki"],
        description: "Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua",
        icon: battery
    },
    {
        title: "Dowóz paliwa",
        points: ["Benzyna", "Olej napędowy"],
        description: "Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua",
        icon: fuel
    },
    {
        title: "Wyciąganie z trudnych miejsc",
        points: ["Rowy", "Błota", "Zaspy"],
        description: "Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua",
        icon: car
    },
    {
        title: "Mobilny mechanik TIR",
        points: ["Naprawy", "Diagnostyka", "Serwis"],
        description: "Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua",
        icon: tir
    },
    {
        title: "Mobilna wulkanizacja TIR",
        points: ["Opony", "Koła", "Serwis"],
        description: "Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua",
        icon: tirTyre
    },
]
---

<section class="py-16 sm:py-20 px-12 sm:px-6 md:px-12 lg:px-20 my-[11vh]">
    <ul class="flex flex-wrap justify-center gap-4 sm:gap-6 lg:gap-8 max-w-6xl mx-auto">
        {data.map((item) => (
                <li class="bg-yellow-400 backdrop-blur-sm rounded-2xl p-6 sm:p-8 flex flex-col gap-4 hover:bg-white/30 hover:-translate-y-1 transition-all duration-300 w-full sm:w-[calc(50%-0.75rem)] lg:w-[calc(33.333%-1.34rem)]">
                    <div class="w-20 h-20 m-auto rounded-xl flex items-center justify-center">
                        {item.icon ? (
                                <Image src={item.icon} alt={item.title} class="w-16 h-16 object-contain"/>
                        ) : (
                                <div class="w-16 h-16 bg-gray-300/60 rounded-lg flex items-center justify-center text-gray-500 text-xs font-semibold">
                                    Ikona
                                </div>
                        )}
                    </div>
                    <div class="flex flex-col gap-1">
                        <h3 class="font-extrabold text-lg sm:text-xl text-black tracking-tight text-center mx-auto">{item.title}</h3>
                        <div class="flex flex-wrap items-center justify-center gap-x-2 gap-y-1 font-semibold text-xs sm:text-sm text-black/70 uppercase tracking-wide mx-auto text-center">
                            {item.points.map((point, index) => (
                                    <>
                                        <span class="text-xs">{point}</span>
                                        {index < item.points.length - 1 && <span class="text-black/50 font-bold">·</span>}
                                    </>
                            ))}
                        </div>
                    </div>
                    <p class="text-black/80 text-sm leading-relaxed text-center">{item.description}</p>
                </li>
        ))}
    </ul>
</section>