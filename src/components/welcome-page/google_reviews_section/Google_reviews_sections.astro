---
import Image from "astro/components/Image.astro";
import {getGoogleReviews} from "../../../data/getGoogleReviews.ts";


const reviews = await getGoogleReviews();
console.log(reviews);



---
<section class="max-w-7xl mx-auto py-20 px-4 relative overflow-hidden">
    <div class="max-w-7xl mx-auto relative z-10">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start mb-16">
            <div class="lg:col-span-7">
                <h2 class="text-4xl md:text-5xl lg:text-6xl font-black uppercase tracking-tight text-[#F4A71D] leading-none">
                    Opinie o naszej<br class="hidden sm:inline"/> pomocy drogowej
                </h2>
            </div>
            <div class="lg:col-span-5 lg:pt-2">
                <p class="text-white text-sm md:text-base font-semibold leading-relaxed">
                    <span class="font-bold">Prawdziwe opinie z Google My Business</span> o naszej pomocy drogowej w Kaliszu i okolicach. Zaufanie kierowców to dla nas najlepsze potwierdzenie skuteczności i niezawodności.
                </p>
            </div>
        </div>

        <div class="relative px-2 md:px-14">

            <button id="google-prev" class="absolute left-0 top-1/2 -translate-y-1/2 bg-yellow-500 text-zinc-600 hover:text-zinc-900 p-4 rounded-full shadow-lg hover:shadow-xl transition-all cursor-pointer z-20 focus:outline-none border" aria-label="Poprzednia opinia">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="3" stroke="currentColor" class="w-5 h-5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5L8.25 12l7.5-7.5" />
                </svg>
            </button>

            <div
                    id="google-reviews-container"
                    class="flex gap-6 overflow-x-auto snap-x snap-mandatory scrollbar-none pb-6 scroll-smooth mx-6"
            >
                {reviews.map((review: any) => (
                        <div class="min-w-full md:min-w-[calc(100%)] lg:min-w-[calc(100%)] bg-yellow-500 rounded-3xl p-8 md:p-10 shadow-[0_10px_30px_rgba(0,0,0,0.04)] border border-black flex flex-col justify-between snap-start min-h-[220px] ">

                            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6">
                                <div class="flex items-center gap-4">
                                    {review.authorAttribution?.photoUri ? (
                                            <img src={review.authorAttribution.photoUri} alt={review.authorAttribution.displayName} class="w-14 h-14 rounded-full object-cover" />
                                    ) : (
                                            <div class="w-14 h-14 rounded-full bg-[#778899] text-white flex items-center justify-center font-bold text-xl shadow-inner">
                                                {review.authorAttribution?.displayName ? review.authorAttribution.displayName.charAt(0).toUpperCase() : 'G'}
                                            </div>
                                    )}

                                    <div>
                                        <h3 class="font-bold text-lg text-zinc-800">
                                            {review.authorAttribution?.displayName || "Użytkownik Google"}
                                        </h3>
                                        <p class="text-xs text-zinc-400 font-medium">{review.relativePublishTimeDescription}</p>
                                    </div>
                                </div>

                                <div class="flex gap-1 text-black">
                                    {Array.from({ length: review.rating || 5 }).map(() => (
                                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-6 h-6">
                                                <path fill-rule="evenodd" d="M10.788 3.21c.448-1.077 1.976-1.077 2.424 0l2.082 5.006 5.404.434c1.164.093 1.636 1.545.749 2.305l-4.117 3.527 1.257 5.273c.271 1.136-.964 2.033-1.96 1.425L12 18.354 7.373 21.18c-.996.608-2.231-.29-1.96-1.425l1.257-5.273-4.117-3.527c-.887-.76-.415-2.212.749-2.305l5.404-.434 2.082-5.005Z" clip-rule="evenodd" />
                                            </svg>
                                    ))}
                                </div>
                            </div>

                            <p class="text-zinc-600 text-base md:text-lg italic font-medium leading-relaxed mb-6">
                                "{review.text?.text || review.text}"
                            </p>

                            <div class="flex items-center gap-2 pt-2 border-t border-black">
                                <svg class="w-4 h-4 text-zinc-400" viewBox="0 0 24 24" fill="currentColor">
                                    <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/>
                                    <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
                                    <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z" fill="#FBBC05"/>
                                    <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z" fill="#EA4335"/>
                                </svg>
                                <span class="text-xs text-zinc-400 font-semibold tracking-wide">Google review</span>
                            </div>
                        </div>
                ))}
            </div>

            <button id="google-next" class="absolute right-0 top-1/2 -translate-y-1/2 bg-yellow-500 text-zinc-600 hover:text-zinc-900 p-4 rounded-full shadow-lg hover:shadow-xl transition-all cursor-pointer z-20 focus:outline-none border" aria-label="Następna opinia">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="3" stroke="currentColor" class="w-5 h-5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" />
                </svg>
            </button>
        </div>

        <div id="google-dots" class="flex justify-center gap-2 mt-8">
            {reviews.map((_: any, index: any) => (
                    <button
                            class={`w-2.5 h-2.5 rounded-full transition-all duration-300 ${index === 0 ? 'bg-[#718096] w-6' : 'bg-zinc-300'}`}
                            aria-label={`Idź do opinii numer ${index + 1}`}
                            data-index={index}
                    ></button>
            ))}
        </div>

    </div>
</section>

<style>
    /* Ukrywanie natywnego suwaka dla estetyki */
    .scrollbar-none::-webkit-scrollbar {
        display: none;
    }
    .scrollbar-none {
        -ms-overflow-style: none;
        scrollbar-width: none;
    }
</style>

<script>
    const container = document.getElementById('google-reviews-container');
    const prevBtn = document.getElementById('google-prev');
    const nextBtn = document.getElementById('google-next');
    const dots = document.querySelectorAll('#google-dots button');

    if (container && prevBtn && nextBtn) {
        const getCardWidth = () => {
            const firstCard = container.firstElementChild as HTMLElement;
            return firstCard ? firstCard.offsetWidth + 24 : 500; // szerokość karty + gap
        };

        // Obsługa kliknięć w strzałki
        nextBtn.addEventListener('click', () => {
            container.scrollLeft += getCardWidth();
        });

        prevBtn.addEventListener('click', () => {
            container.scrollLeft -= getCardWidth();
        });

        // Dynamiczna aktualizacja kropek (dots) podczas przewijania karuzeli
        container.addEventListener('scroll', () => {
            const scrollIndex = Math.round(container.scrollLeft / getCardWidth());
            dots.forEach((dot, idx) => {
                if (idx === scrollIndex) {
                    dot.classList.add('bg-[#718096]', 'w-6');
                    dot.classList.remove('bg-zinc-300');
                } else {
                    dot.classList.remove('bg-[#718096]', 'w-6');
                    dot.classList.add('bg-zinc-300');
                }
            });
        });

        // Obsługa kliknięć bezpośrednio w kropki
        dots.forEach((dot) => {
            dot.addEventListener('click', (e) => {
                const target = e.target as HTMLElement;
                const index = parseInt(target.getAttribute('data-index') || '0');
                container.scrollLeft = index * getCardWidth();
            });
        });
    }
</script>