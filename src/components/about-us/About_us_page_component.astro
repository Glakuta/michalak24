---
import Image from "astro/components/Image.astro";
import photo from "../../assets/DAF_hero.jpg";
import truck from "../../assets/20240907_064515.jpg";


const stats = [
    { value: "10+", label: "Lat doświadczenia" },
    { value: "5000+", label: "Zrealizowanych zleceń" },
    { value: "30 min", label: "Średni czas dojazdu" },
    { value: "24/7", label: "Dostępność" },
];

const values = [
    {
        icon: `<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>`,
        title: "Bezpieczeństwo przede wszystkim",
        desc: "Każde zlecenie realizujemy z najwyższą starannością. Twój pojazd jest u nas bezpieczny od momentu odbioru aż do miejsca docelowego.",
    },
    {
        icon: `<circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>`,
        title: "Błyskawiczny czas reakcji",
        desc: "Docieramy na miejsce średnio w 15–30 minut. Działamy całą dobę, 365 dni w roku — bez wyjątków.",
    },
    {
        icon: `<path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>`,
        title: "Uczciwe podejście",
        desc: "Transparentne ceny, zero ukrytych kosztów. Wycenę otrzymujesz przed przystąpieniem do pracy — zawsze.",
    },
    {
        icon: `<path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>`,
        title: "Obsługa ubezpieczycieli",
        desc: "Współpracujemy z PZU, Wartą, Allianz i innymi. Przejmiemy całą komunikację z ubezpieczycielem za Ciebie.",
    },
];

const fleet = [
    {
        name: "Laweta standard",
        desc: "Transport osobówek i małych aut dostawczych. Załadunek najazdowy, platforma aluminiowa.",
        capacity: "Do 3,5 t",
        img: "/images/fleet/laweta-standard.jpg",
    },
    {
        name: "Laweta ciężka",
        desc: "Transport busów, vanów i pojazdów ciężarowych. Zwiększony udźwig i wzmocniona platforma.",
        capacity: "Do 7 t",
        img: "/images/fleet/laweta-ciezka.jpg",
    },
    {
        name: "Pojazd serwisowy",
        desc: "Szybka pomoc na miejscu — rozruch, wymiana koła, otwarcie pojazdu, paliwo.",
        capacity: "Pomoc mobilna",
        img: "/images/fleet/serwis.jpg",
    },
];

const areas = ["Kalisz", "Ostrów Wielkopolski", "Droga ekspresowa s12", "Autostrada A2"];
---
<main class="bg-black min-h-screen">
        <div class="relative h-72 md:h-[50vh] overflow-hidden flex items-end">
            <div class="absolute inset-0 ">
                <Image src={photo} alt="Michalak 24" class="w-full object-cover object-center h-[60vh]"/>
                <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-black/40 to-white/40"></div>
            </div>

            <div class="relative z-10 max-w-7xl mx-auto px-6 md:px-12 lg:px-20 pb-12 w-full">
                <span class="text-yellow-400 text-xs font-bold uppercase tracking-[0.25em]">Kim jesteśmy</span>
                <h1 class="mt-1 text-5xl md:text-6xl font-black text-white leading-tight uppercase">
                    O firmie <span class="text-yellow-400">Michalak24</span>
                </h1>
            </div>
        </div>

            <div class="grid grid-cols-1 w-full lg:grid-cols-3 gap-4 lg:mt-0 mx-auto bg-yellow-500 p-8 md:p-12 rounded-[2rem] md:rounded-[3rem] shadow-2xl text-zinc-900 -skew-x-5 my-[11vh] max-w-7xl">
                <div class=" p-8 md:p-12 lg:p-16 flex flex-col justify-center gap-6 lg:col-span-1 text-white">
                    <div class="flex flex-col gap-6 lg:pt-0 pt-8">
                        <div>
                            <span class="text-yellow-400 text-xs font-bold uppercase tracking-[0.25em]">Nasza historia</span>
                            <h2 class="mt-2 text-4xl md:text-4xl font-black text-white leading-tight">
                                O Michalak<span class="text-yellow-400">24</span>
                            </h2>
                        </div>

                        <p class="text-zinc-300 text-base leading-relaxed">
                            Nie jesteśmy zwykłą pomocą drogową — jesteśmy zaufanym partnerem certyfikowanym przez największe towarzystwa ubezpieczeniowe w Polsce, obsługującym zarówno klientów indywidualnych, jak i flotowych z precyzją, troską i niezrównanym profesjonalizmem.
                        </p>

                        <p class="text-zinc-300 text-base leading-relaxed">
                            Wierzymy w transparentność, <strong class="text-yellow-400 font-semibold">uczciwość i rzetelne wykonanie usługi</strong> za pierwszym razem. Od nagłych awarii po złożone holowanie długodystansowe — naszą reputację budujemy na integrytecie i ciężkiej pracy.
                        </p>


                        <div class="border-l-4 border-yellow-400 bg-zinc-900 rounded-r-xl px-6 py-4">
                            <p class="text-white font-bold text-xl md:text-2xl">Ponad 10 lat doświadczenia na drodze</p>
                        </div>
                    </div>
                </div>

                <div class="relative lg:col-span-2 h-full md:h-[450px] lg:h-auto min-h-[400px] overflow-hidden group">
                    <Image
                            src={truck}
                            alt="Michalak24 - Pomoc Drogowa"
                            class="w-full h-[920px] object-cover object-center"
                    />
                    <div class="absolute inset-0 bg-black/10 group-hover:bg-black/20 transition-colors duration-300"></div>
                </div>

                <div class="bg-yellow-400 p-8 md:p-12 lg:pl-16 lg:col-span-2 flex flex-col justify-center gap-2 text-zinc-900">
                    <h3 class="text-xl md:text-2xl font-black uppercase tracking-wide">
                        Potrzebujesz pomocy? Zadzwoń!
                    </h3>
                    <a href="tel:" class="text-2xl md:text-3xl font-black hover:underline transition-all">
                        +48 571 531 112
                    </a>
                </div>

                <div class=" p-8 md:p-12 lg:col-span-1 flex items-center justify-center border-t lg:border-t-0 lg:border-l border-zinc-100">
                    <a href="tel:+48123456789"
                       class="inline-flex items-center gap-3 bg-yellow-400 hover:bg-yellow-300 text-black font-black text-lg px-8 py-4 rounded-xl transition-all duration-200 hover:-translate-y-0.5 hover:shadow-lg hover:shadow-yellow-400/20 w-fit mt-2"
                    >
                        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor">
                            <path d="M6.62 10.79a15.053 15.053 0 006.59 6.59l2.2-2.2a1 1 0 011.01-.24c1.12.37 2.33.57 3.58.57a1 1 0 011 1V20a1 1 0 01-1 1C10.61 21 3 13.39 3 4a1 1 0 011-1h3.5a1 1 0 011 1c0 1.25.2 2.46.57 3.58a1 1 0 01-.25 1.01l-2.2 2.2z"/>
                        </svg>
                        +48 123 456 789
                    </a>
                </div>
            </div>
            <div class="bg-yellow-400">
                <div class="max-w-7xl mx-auto px-6 md:px-12 lg:px-20 grid grid-cols-2 lg:grid-cols-4">
                    {stats.map((s, i) => (
                            <div class={`py-6 px-4 text-center ${i < stats.length - 1 ? 'border-r border-yellow-500' : ''}`}>
                                <p class="text-4xl font-black text-black leading-none">{s.value}</p>
                                <p class="mt-1 text-xs font-bold uppercase tracking-widest text-black/60">{s.label}</p>
                            </div>
                    ))}
                </div>
            </div>





        <div class="border-t border-zinc-800 py-20 px-6 md:px-12 lg:px-20 bg-zinc-950">
            <div class="max-w-7xl mx-auto">
                <span class="text-yellow-400 text-xs font-bold uppercase tracking-[0.25em]">Czym się kierujemy</span>
                <h2 class="mt-2 text-4xl font-black text-white uppercase mb-12">Nasze wartości</h2>

                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
                    {values.map((v) => (
                            <li class="bg-yellow-400 backdrop-blur-sm rounded-2xl p-8 flex flex-col gap-4 hover:bg-white/30 hover:-translate-y-1 transition-all duration-300 skew-x-5">
                                <!--<div class="w-20 h-20 m-auto  rounded-xl flex items-center justify-center">-->
                                <!--    <Image src={v.icon} alt="Transport auta - Michalak24" class="w-16 h-16 object-contain"/>-->
                                <!--</div>-->
                                <div class="flex flex-col gap-1">
                                    <h3 class="font-extrabold text-xl text-black tracking-tight mx-auto">{v.title}</h3>

                                </div>
                                <p class="text-black/80 text-sm leading-relaxed">{v.desc}</p>
                            </li>
                    ))}
                </div>
            </div>
        </div>
        <div class="border-t border-zinc-800 py-20 px-6 md:px-12 lg:px-20 bg-zinc-950">
            <div class="max-w-7xl mx-auto">
                <div class="grid grid-cols-1 gap-16 items-center">
                    <div class="flex flex-col gap-6">
                        <div>
                            <span class="text-yellow-400 text-xs font-bold uppercase tracking-[0.25em]">Gdzie działamy</span>
                            <h2 class="mt-2 text-4xl font-black text-white uppercase leading-tight">
                                Kalisz i cały<br/><span class="text-yellow-400">region</span>
                            </h2>
                        </div>
                        <p class="text-zinc-300 text-base leading-relaxed">
                            Nasz zasięg obejmuje Kalisz i okoliczne powiaty, ale realizujemy też zlecenia dalekodystansowe na terenie całej Polski i za granicą. Jeśli potrzebujesz pomocy — zadzwoń, dotrzemy.
                        </p>
                        <div class="flex flex-wrap gap-2">
                            {areas.map(area => (
                                    <span class="flex items-center gap-1.5 text-sm font-bold text-black bg-yellow-400 px-3 py-1.5 rounded-full uppercase tracking-wide">
                  <span class="w-1.5 h-1.5 rounded-full bg-black/30 inline-block"></span>
                                        {area}
                </span>
                            ))}
                        </div>
                    </div>
                </div>
            </div>
        </div>

    </main>
