---
const services = [
    { title: "Pomoc drogowa", img: "https://images.unsplash.com/photo-1486006396193-471cf6a5ffca?q=80&w=800", href:"uslugi/pomoc-drogowa-24h-osobowe-dostawcze-i-ciezarowe" },
    { title: "Uruchamianie pojazdów", img: "https://images.unsplash.com/photo-1562141989-c5c79ac8f576?q=80&w=800", href: "uslugi/awaryjne-odpalanie-samochodu" },
    { title: "Awaryjne otwieranie aut", img: "https://images.unsplash.com/photo-1562141989-c5c79ac8f576?q=80&w=800", href: "uslugi/awaryjne-otwieranie-samochodow" },
    { title: "Kasacja pojazdow - złomowanie", img: "https://images.unsplash.com/photo-1506521781263-d8422e82f27a?q=80&w=800", href: "/uslugi/kasacja-pojazdow-zlomowanie" },
    { title: "Usługi dźwigowe - HDS", img: "https://images.unsplash.com/photo-1601584115197-04ecc0da31d7?q=80&w=800", href: "/uslugi/uslugi-dzwigowe-hds" },
    { title: "Wyciąganie aut z rowu czy błota", img: "https://images.unsplash.com/photo-1558981403-c5f9899a28bc?q=80&w=800", href: "/uslugi/wyciaganie-pojazdow-z-rowow-blota-i-sniegu" },
    { title: "Parking strzeżony", img: "https://images.unsplash.com/photo-1544620347-c4fd4a3d5957?q=80&w=800", href: "/uslugi/parking-strzezony-kalisz-24h"},
    { title: "Wypożyczalnia aut", img: "https://images.unsplash.com/photo-1552519507-da3b142c6e3d?q=80&w=800", href: "/uslugi/wypozyczalnia-samochodow" },
];
---
<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4 max-w-7xl mx-auto">
    {services.map((service) => (
            <a class="group relative h-64 md:h-56 overflow-hidden cursor-pointer bg-black" href={service.href}>
                <img
                        src={service.img}
                        alt={service.title}
                        class="w-full h-full object-cover opacity-60 group-hover:opacity-40 group-hover:scale-110 transition-all duration-700"
                />

                <div class="absolute inset-0 flex items-center p-6">
                    <h3 class="text-white font-bold text-lg leading-tight flex items-center gap-2 group-hover:text-yellow-400 transition-colors">
                        {service.title}
                        <span class="bg-yellow-500 text-2xl transition-transform group-hover:translate-x-2">→</span>
                    </h3>
                </div>

                <div class="absolute bottom-0 left-0 w-full h-1 bg-yellow-500 scale-x-0 group-hover:scale-x-100 transition-transform duration-500 origin-left"></div>
            </a>
    ))}
</div>