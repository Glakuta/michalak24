---
import Image from "astro/components/Image.astro";
import photo from "../../../assets/DAF_hero.jpg"

const services = [
    { title: "Mobilny mechanik", img: "https://images.unsplash.com/photo-1486006396193-471cf6a5ffca?q=80&w=800" },
    { title: "Wyciąganie aut z rowu czy błota", img: "https://images.unsplash.com/photo-1544620347-c4fd4a3d5957?q=80&w=800" },
    { title: "Uruchamianie pojazdów", img: "https://images.unsplash.com/photo-1562141989-c5c79ac8f576?q=80&w=800" },
    { title: "Wyciąganie aut z garaży podziemnych", img: "https://images.unsplash.com/photo-1506521781263-d8422e82f27a?q=80&w=800" },
    { title: "Skup aut", img: "https://images.unsplash.com/photo-1552519507-da3b142c6e3d?q=80&w=800" },
    { title: "Transport motocykli", img: "https://images.unsplash.com/photo-1558981403-c5f9899a28bc?q=80&w=800" },
    { title: "Holowanie ciężarówek", img: "https://images.unsplash.com/photo-1601584115197-04ecc0da31d7?q=80&w=800" },
    { title: "Transport agregatów prądotwórczych", img: "https://images.unsplash.com/photo-1581092160562-40aa08e78837?q=80&w=800" },
];

---

<main class="bg-black min-h-screen flex flex-col gap-32">
    <div class="relative h-64 md:h-[60vh] overflow-hidden flex items-end bg-zinc-900">
        <div class="absolute inset-0 bg-gradient-to-br from-zinc-900 to-zinc-800">
            <Image src={photo} alt="Michalak 24" class="w-full"/>
        </div>

        <div class="relative z-10 max-w-7xl mx-auto px-6 md:px-12 lg:px-20 pb-12 w-full">
            <span class="text-yellow-400 text-xs font-bold uppercase tracking-[0.25em]">Co oferujemy</span>
            <h1 class="mt-1 text-5xl md:text-6xl font-black text-white leading-tight uppercase">
                Nasze <span class="text-yellow-400">usługi</span>
            </h1>
        </div>
    </div>
    <div class="max-w-7xl mx-auto px-6 md:px-12 lg:px-20 py-12 border-b border-zinc-800">
        <div class="flex flex-col md:flex-row  gap-6">
            <p class="text-zinc-400 text-lg max-w-2xl leading-relaxed">
                Specjalizujemy się w kompleksowej pomocy drogowej na terenie Kalisza i całego regionu.
                Każde zlecenie realizujemy szybko, uczciwie i bez ukrytych kosztów.
            </p>
        </div>
    </div>
    <div class="flex flex-col md:flex-row justify-center items-center mb-12 gap-8">
        <div class="max-w-4xl">
            <h2 class="text-4xl md:text-5xl font-extrabold text-yellow-400 leading-tight mb-8 uppercase tracking-tighter">
                Oferujemy pomoc drogową na terenie Kalisza i okolic – szybko, sprawnie i uczciwie
            </h2>
            <p class="text-gray-700 leading-relaxed text-sm md:text-base">
                Pomagamy w każdej sytuacji awaryjnej – zarówno na trasie, jak i na terenie miasta Kalisza i okolic. Obsługujemy wszystkie dzielnice: . Naszą pomoc drogową cechuje błyskawiczna reakcja i rzetelność. Wystarczy jeden telefon, a nasza auto pomoc drogowa Warszawa przyjedzie na miejsce w ciągu kilkunastu minut.
            </p>
        </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4 max-w-7xl mx-auto">
        {services.map((service) => (
                <div class="group relative h-48 md:h-56 overflow-hidden cursor-pointer bg-black">
                    <img
                            src={service.img}
                            alt={service.title}
                            class="w-full h-full object-cover opacity-60 group-hover:opacity-40 group-hover:scale-110 transition-all duration-700"
                    />

                    <div class="absolute inset-0 flex items-center p-6">
                        <h3 class="text-white font-bold text-lg leading-tight flex items-center gap-2 group-hover:text-yellow-400 transition-colors">
                            {service.title}
                            <span class="bg-yellow-500 text-2xl transition-transform group-hover:translate-x-2">→</span>
                        </h3>
                    </div>

                    <div class="absolute bottom-0 left-0 w-full h-1 bg-yellow-500 scale-x-0 group-hover:scale-x-100 transition-transform duration-500 origin-left"></div>
                </div>
        ))}
    </div>
    <div class="bg-yellow-400 py-16 px-6 md:px-12 lg:px-20">
        <div class="max-w-7xl mx-auto flex flex-col md:flex-row items-center justify-between gap-6">
            <div>
                <h2 class="text-3xl md:text-4xl font-black text-black uppercase leading-tight">
                    Nie wiesz której usługi potrzebujesz?
                </h2>
                <p class="text-black/60 font-bold mt-1 uppercase tracking-wide text-sm">
                    Zadzwoń — doradzimy i wyślemy właściwy pojazd
                </p>
            </div>

            <a href="tel:571531112"
               class="flex items-center gap-3 bg-black text-white font-black text-sm tracking-widest uppercase px-8 py-4 rounded-full transition-all duration-200 hover:-translate-y-0.5 hover:shadow-xl shrink-0"
            >
                <span class="relative flex items-center justify-center w-8 h-8 bg-green-500 rounded-full shrink-0">
            <span class="absolute inset-0 rounded-full bg-green-500 animate-ping opacity-50"></span>
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-white relative z-10 rotate-12" fill="currentColor" viewBox="0 0 24 24">
              <path d="M6.62 10.79a15.05 15.05 0 0 0 6.59 6.59l2.2-2.2a1 1 0 0 1 1.01-.24c1.12.37 2.33.57 3.58.57a1 1 0 0 1 1 1V20a1 1 0 0 1-1 1C10.61 21 3 13.39 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.46.57 3.58a1 1 0 0 1-.24 1.01l-2.21 2.2z"/>
            </svg>
          </span>
                Zadzwoń — 571 531 112
            </a>
        </div>
    </div>

</main>
